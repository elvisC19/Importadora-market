# ── Database ──────────────────────────────────────────────
# SQLite (development)
DATABASE_URL=sqlite:///./dev.db
# PostgreSQL (production) — just change this line, zero code changes needed
# DATABASE_URL=postgresql://user:password@localhost:5432/importadora_market

# ── JWT / Auth ────────────────────────────────────────────
SECRET_KEY=change-this-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# ── SMTP (email) ──────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── Admin ─────────────────────────────────────────────────
ADMIN_EMAIL=

# ── Frontend ──────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
